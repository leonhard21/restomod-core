# Porta em que a API vai escutar
PORT=8080

# String de conexão do PostgreSQL (Prisma)
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL=postgresql://postgres:1234@localhost:5432/oficina_db

# Segredo usado para assinar/verificar os tokens JWT (gere um valor aleatório forte)
JWT_SECRET=troque_por_um_segredo_forte_e_aleatorio

# Tempo de expiração do token JWT
JWT_EXPIRES_IN=1d

# Origem permitida pelo CORS (endereço do frontend)
CORS_ORIGIN=http://localhost:3000
